    });
%}


###############################################################################
# §7  定时任务（需要手工 SQL 拨时间 + 等待/触发）
#     说明：这些东西无法用纯 HTTP 触发，必须配合 SQL。
#     超时取消 cron = 每 1 分钟（0 * * * * ?）→ 拨完时间等 1 分钟即可
#     其余三个是每日任务，见下方说明。
###############################################################################

# ─────────────────────────────────────────────────────────────────────────────
#  【手工 SQL】在 IDEA Database 工具窗口执行，然后回到这里发下面的验证请求
# ─────────────────────────────────────────────────────────────────────────────
#
#  A. 超时取消（0→4 + 库存回补）—— 任务每分钟跑，拨完等 1 分钟
#     UPDATE campus_market.tb_order
#        SET create_time = NOW() - INTERVAL 16 MINUTE
#      WHERE id = <一个 status=0 的订单ID> AND status = 0;
#     验证：SELECT id,status,cancel_by,cancel_reason FROM campus_market.tb_order WHERE id=<该ID>;
#           期望 status=4, cancel_by=0, cancel_reason='超时未支付自动取消'
#
#  B. 自动确认收货（2→3）—— cron "0 30 2 * * ?" 每日 02:30
#     UPDATE campus_market.tb_order
#        SET ship_time = NOW() - INTERVAL 8 DAY
#      WHERE id = <一个 status=2 的订单ID> AND status = 2;
#     ⚠️ 改完不会立刻触发。要当场验证，把 ScheduledTasks#autoConfirmReceive 的 cron
#        临时改成 "0 * * * * ?" 后重启应用，验完改回来。
#
#  C. 收货前 24 小时提醒（站内信）—— cron "0 0 10 * * ?" 每日 10:00
#     UPDATE campus_market.tb_order
#        SET ship_time = NOW() - INTERVAL 156 HOUR
#      WHERE id = <一个 status=2 的订单ID> AND status = 2;
#     同样需要临时改 cron 为 "0 * * * * ?" 才能当场看到效果。
#
#  D. 退款被拒超时恢复（7→1/2）—— cron "0 0 3 * * ?" 每日 03:00
#     UPDATE campus_market.tb_order
#        SET refund_reject_time = NOW() - INTERVAL 4 DAY
#      WHERE id = <一个 status=7 的订单ID> AND status = 7;
#     期望 status 恢复为 1（未发货）或 2（已发货）。同样需要临时改 cron。
#
#  通用核对 SQL：
#     SELECT id,order_no,user_id,seller_id,product_id,status,quantity,trade_type,
#            create_time,pay_time,ship_time,finish_time,cancel_time,cancel_by,
#            refund_apply_time,refund_reject_time
#       FROM campus_market.tb_order ORDER BY id DESC LIMIT 20;
#     SELECT id,title,price,stock,status,is_deleted
#       FROM campus_market.tb_product ORDER BY id DESC LIMIT 20;
#     SELECT id,user_id,type,biz_type,biz_id,is_read,content
#       FROM campus_market.tb_notification ORDER BY id DESC LIMIT 20;
#     SELECT id,operator_id,operation_type,target_type,target_id,result,detail
#       FROM campus_market.tb_audit_log ORDER BY id DESC LIMIT 20;
#
#  ⚠️ ShedLock：若定时任务完全不执行，先查是否有卡住的锁
#     SELECT * FROM campus_market.shedlock;
#     -- 确认 lock_until 已过期；必要时清掉：
#     DELETE FROM campus_market.shedlock WHERE name = 'cancelTimeoutOrderTask';
# ─────────────────────────────────────────────────────────────────────────────


### 7.1 定时任务效果验证：管理端按状态筛选订单
# 执行完上面 SQL 并等待后，用这个接口核对状态变化
GET {{base}}/admin/order/list?status=4&page=1&size=20
Authorization: Bearer {{admin_token}}

> {%
    client.test("7.1 已取消订单列表（含超时取消 cancel_by=0）", function () {
        client.assert(response.body.code === 200, "code 应为 200，实际 " + response.body.code);
        client.log("已取消订单数：" + response.body.data.total);
    });
%}


### 7.2 定时任务提醒站内信验证：买家通知列表
GET {{base}}/notification/list?page=1&size=20
Authorization: Bearer {{buyer_token}}

> {%
    client.test("7.2 买家通知列表可查（自动确认收货前提醒会落在这里）", function () {
        client.assert(response.body.code === 200, "code 应为 200，实际 " + response.body.code);
        client.log("买家收到站内信条数：" + response.body.data.total);
    });
%}


###############################################################################
# §8  ★★★ 破坏性用例 ★★★  —— 务必最后执行！
#     账号锁定会封 15 分钟、IP 限流会封 30 分钟，跑完你就登不进系统了。
###############################################################################

### 8.1a 验证码限流（第1步：首次取码 → 期望 200）
# 先成功取一次
GET {{base}}/auth/email-code?email={{locktest_email}}&scene=RESET_PASSWORD

### 8.1b 验证码限流（第2步：60 秒内重复取码 → 期望 code=106）
# 立刻再取一次（60 秒内）→ 106
GET {{base}}/auth/email-code?email={{locktest_email}}&scene=RESET_PASSWORD

> {%
    client.test("8.1 60 秒内重复获取验证码 → code=106 / msg=发送过于频繁，请稍后重试", function () {
        client.assert(response.body.code === 106, "code 应为 106，实际 " + response.body.code + " / " + response.body.msg);
        client.assert(response.body.msg === "发送过于频繁，请稍后重试", "msg 不符，实际 " + response.body.msg);
    });
%}


### 8.2a 验证码爆破锁定（第1步：取码 RESET_PASSWORD）
# ⚠️ email:fail 在 1 小时内【不可重置】，重新获取验证码也不会清零。
#    要反复测请换邮箱，或手工清理：redis-cli DEL email:fail:{{locktest_email}}
# 第 1 次：先取验证码，再用错误验证码重置密码
GET {{base}}/auth/email-code?email={{locktest_email}}&scene=RESET_PASSWORD

### 8.2b 验证码爆破锁定（第2步：错误验证码 → 期望 code=103）
POST {{base}}/auth/reset-password
Content-Type: application/json

{
  "email": "{{locktest_email}}",
  "emailCode": "000000",
  "newPassword": "{{pwd_new}}"
}

> {%
    client.test("8.2a 错误验证码 → code=103 / msg=验证码错误或已过期", function () {
        client.assert(response.body.code === 103, "code 应为 103，实际 " + response.body.code + " / " + response.body.msg);
    });
%}

### 8.2c 验证码爆破锁定（第3步：失败 5 次后再取码 → 期望 code=107）
# 请把下面这一组「取码 + 错误重置」再手工执行 4 遍（每次间隔分别点 ▶），
# 第 5 次失败后再点下面这个取码请求即可看到 107。
GET {{base}}/auth/email-code?email={{locktest_email}}&scene=RESET_PASSWORD

> {%
    client.test("8.2b 失败 5 次后取码 → code=107（若仍为 200/106 说明失败次数还不够 5 次）", function () {
        client.log("当前 code=" + response.body.code + " msg=" + response.body.msg);
        client.assert(response.body.code === 107 || response.body.code === 200 || response.body.code === 106,
            "预期 107（已锁定）或尚未累积够 5 次");
    });
%}


### 8.3 ★账号锁定：连续 5 次错误密码 → 104（锁定 15 分钟）
# ⚠️ 专用账号 locktest{{run}}，不会影响前面的用例。
#    内部计数：login:fail:{{locktest_user}}，达 5 次写 login:lock:{{locktest_user}}
# 请把下面这个请求【连续点 ▶ 共 5 次】，然后点 8.4 验证。
POST {{base}}/auth/login
Content-Type: application/json

{
  "username": "{{locktest_user}}",
  "password": "WrongPassword!999"
}

> {%
    client.log("第 N 次失败，code=" + response.body.code + " msg=" + response.body.msg);
    client.test("8.3 错误密码 → code=101（第 5 次起变为 104）", function () {
        client.assert(response.body.code === 101 || response.body.code === 104,
            "code 应为 101（未达阈值）或 104（已锁定）");
    });
%}


### 8.4 锁定确认：即使密码正确也应被拒 → 104
POST {{base}}/auth/login
Content-Type: application/json

{
  "username": "{{locktest_user}}",
  "password": "{{pwd}}"
}

> {%
    client.test("8.4 锁定期间正确密码也拒绝 → code=104 / msg=账号已锁定15分钟", function () {
        client.assert(response.body.code === 104, "code 应为 104，实际 " + response.body.code + " / " + response.body.msg);
        client.assert(response.body.msg === "账号已锁定15分钟", "msg 不符，实际 " + response.body.msg);
    });
%}


### 8.5 ★IP 限流：同 IP 5 分钟内失败 20 次 → 104
# 🔴🔴 最高危：执行后你的 IP 会被封 30 分钟，所有登录都会失败！
#      清理命令（在锁定期内也能执行，Redis 是独立的）：
#        redis-cli DEL login:fail:ip:127.0.0.1
#        redis-cli DEL login:lock:ip:127.0.0.1
#      若不知道真实 IP 键名，用：
#        redis-cli --scan --pattern "login:*ip*"
#      或在 redis-cli 里执行：
#        EVAL "for _,k in ipairs(redis.call('keys','login:lock:ip:*')) do redis.call('del',k) end return 1" 0
#
# 把下面这个请求连续点 ▶ 20 次以上：
POST {{base}}/auth/login
Content-Type: application/json

{
  "username": "{{buyer_user}}",
  "password": "WrongPassword!999"
}

> {%
    client.log("IP 失败累积中，code=" + response.body.code + " msg=" + response.body.msg);
    client.test("8.5 IP 失败累积（第 20 次起 → 104 IP已被临时限制）", function () {
        client.assert(response.body.code === 101 || response.body.code === 104,
            "code 应为 101（未达阈值）或 104（IP 已限流）");
    });
%}


###############################################################################
# §9  无法用 .http 脚本化的用例（需要写代码/JMeter）
###############################################################################

# ─────────────────────────────────────────────────────────────────────────────
#  §6「并发抢购：1000 线程抢 1 件商品」—— 论文核心数据，必须单独实现。
#
#  为什么不能在这里做：HTTP Client 发不出 1000 个真正并发的请求（它是顺序执行的），
#  而且拿不到「库存最终归零」「仅 1 单成功」这类需要原子断言的结论。
#
#  推荐做法（任选其一）：
#   ① JUnit 5 + CountDownLatch + ThreadPoolExecutor（连真实 MySQL/Redis，最贴合文档要求）
#      - 准备：上架一个 stock=1 的商品
#      - 1000 个线程同时抢 → 期望：恰好 1 个 code=200，其余 999 个 code=201（库存不足）
#      - 断言：SELECT stock,status FROM tb_product WHERE id=? → stock=0, status=2（售罄）
#      - 断言：SELECT COUNT(*) FROM tb_order WHERE product_id=? → 1
#   ② JMeter 1000 线程 / Ramp-up 0 → 看聚合报告里 200 与 201 的计数
#
#  这个用例的代码我可以直接帮你写（含断言与 SQL 核对），需要的话告我。
# ─────────────────────────────────────────────────────────────────────────────


###############################################################################
# §10  失败用例一览（跑完后请重点回填这里）
###############################################################################
#
#  §6 里有一条用例在当前配置下【必然跑不出预期结果】，先说明清楚，免得你白排查：
#
#  ✗ 「邮件发送失败 → code=105 / msg=邮件发送失败，请稍后重试」
#     原因：dev profile 的 app.email.skip=true，send() 方法在 skip 分支直接 return，
#           根本不会走 SMTP，所以 MailException 永远不会抛。
#     要验证它：把 EMAIL_SKIP 设为 false + 配一个不可达的 MAIL_HOST（如 127.0.0.1:1），
#               重启后用【新邮箱】请求验证码，即可看到 105。
#     （注意：105 时后端会删除本次验证码，见 EmailCodeServiceImpl#sendByMail）
#
#  §6 里两条需要「等」的用例：
#  ✗ 「超时取消 15 分钟未支付」→ 见 §7-A 的 SQL 加速
#  ✗ 「自动确认收货 7 天 / 前 24 小时提醒 / 退款被拒 3 天恢复」→ 见 §7-B/C/D，
#     且这三个是每日 cron，需要临时改成每分钟才能当场验证。
#
###############################################################################
