        client.assert(response.body.code === 200, "code 应为 200，实际 " + response.body.code + " / " + response.body.msg);
        client.assert(!!response.body.data.orderId, "应返回 orderId");
        client.assert(Number(response.body.data.amount) === 25.00, "amount 应为 product_price×quantity=25.00，实际 " + response.body.data.amount);
        client.assert(response.body.data.status === 0, "新订单 status 应为 0（待支付）");
    });
%}


