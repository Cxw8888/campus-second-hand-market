# =============================================================================
#  §1.2  ★★★ 手工 SQL 闸门 GATE ★★★   —— 必须在执行 §1.3 之前完成
# =============================================================================
#
#  为什么必须手工：数据库里没有任何管理员账号，DDL 只 seed 了 6 条分类。
#  为什么用 LIKE：这样脚本重复运行时不用改 SQL（{{run}} 后缀会自动变）。
#
#  在 IDEA 的 Database 工具窗口（或 MySQL Workbench）里执行：
#
#  -- ① 提权为管理员（role 写进了 JWT，所以提权后必须重新登录才生效）
#  UPDATE campus_market.tb_user SET role = 1 WHERE username LIKE 'admin%';
#
#  -- ② 确认（应看到 admin<run> 的 role=1）
#  SELECT id, username, role, status FROM campus_market.tb_user ORDER BY id;
#
#  -- ③ 确认 Flyway 已迁移（应看到 V1__init.sql success=1, installed_by=campus_user）
#  SELECT version, description, success, installed_by, installed_on
#    FROM campus_market.flyway_schema_history;
#
#  ※ 若跳过本闸门：§1.11 管理员登录仍会成功，但所有 §7 管理端接口返回 403
#    （这本身就是 §2.2 的「管理员越权」用例，可以顺带验证）。
# =============================================================================


### 1.11 卖家 · 登录 → 保存 seller_token
POST {{base}}/auth/login
Content-Type: application/json

{
  "username": "{{seller_user}}",
  "password": "{{pwd}}"
}

> {%
    client.global.set("seller_token", response.body.data ? response.body.data.token : "");
    client.test("1.11 卖家登录 → token 且 role=0", function () {
        client.assert(response.body.code === 200, "code 应为 200，实际 " + response.body.code + " / " + response.body.msg);
        client.assert(response.body.data.role === 0, "卖家 role 应为 0，实际 " + response.body.data.role);
    });
%}


