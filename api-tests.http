        client.assert(response.body.code === 200, "code 应为 200，实际 " + response.body.code);
        client.assert(response.body.data.status === 3,
            "关键字段(title)变更后 status 应为 3-待审核，实际 " + response.body.data.status
            + "（若为 1 说明重审逻辑未生效）");
        client.assert(response.body.data.title === "重审测试商品-已改标题", "标题应已更新");
    });
%}


