}

> {%
    client.global.set("o7", response.body.data ? response.body.data.orderId : "");
    client.global.set("o7_no", response.body.data ? response.body.data.orderNo : "");
%}

### 4.28c 支付回调幂等（第3步：首次回调 → 期望 data=true）
# 【6.0.2 起必须签名】下面的预请求脚本用 IDEA HTTP Client 的 crypto API 现算签名：
#   payload = orderNo|tradeNo|timestamp（毫秒）
#   sign    = HMAC-SHA256(payload, PAY_CALLBACK_SECRET) 十六进制小写
# 脚本里的密钥取自 {{pay_callback_secret}}（见 0.0 与文件头注意事项 9），必须与后端一致。
> {%
    const tradeNo = "TRADE-ACCEPT-001";
    const ts = Date.now();
    const payload = client.global.get("o7_no") + "|" + tradeNo + "|" + ts;
    const sign = crypto.hmac.sha256()
        .withTextSecret(client.global.get("pay_callback_secret"))
        .updateWithText(payload)
        .digest()
        .toHex()
        .toLowerCase();
    client.global.set("cb_ts", ts);
    client.global.set("cb_sign", sign);
%}
POST {{base}}/order/pay/callback
Content-Type: application/json

{
  "orderNo": "{{o7_no}}",
  "tradeNo": "TRADE-ACCEPT-001",
  "timestamp": {{cb_ts}},
  "sign": "{{cb_sign}}"
}

> {%
    client.test("4.28a 首次支付回调 → data=true", function () {
        client.assert(response.body.code === 200, "code 应为 200，实际 " + response.body.code + " / " + response.body.msg);
        client.assert(response.body.data === true, "首次回调 data 应为 true，实际 " + response.body.data);
    });
%}

### 4.28d 支付回调幂等（第4步：重复回调 → 期望 data=false）
# 刻意【不重新签名】：复用 4.28c 的 timestamp 与 sign，构成"同一笔回调被重放"的真实场景
#（验签通过 → 命中 Redis 去重键 pay:callback:{orderNo}:{tradeNo} → data=false）。
POST {{base}}/order/pay/callback
Content-Type: application/json

{
  "orderNo": "{{o7_no}}",
  "tradeNo": "TRADE-ACCEPT-001",
  "timestamp": {{cb_ts}},
  "sign": "{{cb_sign}}"
}

> {%
    client.test("4.28b 重复支付回调 → data=false（幂等去重）", function () {
        client.assert(response.body.code === 200, "code 应为 200，实际 " + response.body.code + " / " + response.body.msg);
        client.assert(response.body.data === false, "重复回调 data 应为 false，实际 " + response.body.data);
    });
%}


