###############################################################################
#  校园二手交易平台 · 端到端验收脚本
#  对应 PROJECT_CONTEXT.md (V26) 第 6 章「验收标准与关键接口测试用例」
#
#  文件位置：项目根目录  C:\Users\chen\Desktop\rwuru\api-tests.http
#  IDEA 中打开：双击文件 → 右上角选择运行环境 → 逐条点请求左侧的 ▶
#
#  ─────────────────────────── 执行前必读 ───────────────────────────
#  1. 必须【先执行 0.0 环境自检】。它会写入 {{base}} 与本次运行的唯一后缀 {{run}}，
#     没有它后面所有请求的 {{base}} 都解析不了。
#  2. 变量串联链路（全部由响应处理器里的 client.global.set 自动完成，无需手工复制）：
#       注册 → userId → 登录 → token → 发布商品 → productId → 下单 → orderId
#  3. 【有 1 处必须手工执行 SQL】：把 admin 提权为 role=1（见 §1.2 的 GATE）。
#     没有管理员账号是数据库里的事实（tb_user 无 seed），不执行则 §7 全部返回 403。
#  4. 【破坏性用例集中在 §8】，会锁账号 15 分钟、锁 IP 30 分钟，务必最后跑。
#  5. JacksonConfig 把【所有 Long 都序列化成 JSON 字符串】，所以 id/total/count 在
#     响应里是 "123" 而不是 123。本脚本已按此处理，你自己加断言时请注意。
#  6. 业务失败也是 HTTP 200，只有未登录/Token 失效是 HTTP 401。
#  7. 【401 文案分两类】都是 HTTP 401，前端只需判断 code === 401：
#       未携带凭证（无 Authorization 头 / 非 Bearer / Token 为空） → msg="请先登录"
#       携带但不可用（登出黑名单 / 已过期 / 签名被篡改 / payload 缺字段） → msg="登录已失效，请重新登录"
#     覆盖用例：0.2(请先登录) / 2.3(登录已失效) / 2.7(登录已失效) / 2.12(登录已失效) / 2.13(登录已失效)
#  8. 【两个重点回归点】历史缺陷已修复，断言专门针对它们设计：
#       3.20   AI 检索 ?query= 必须真正映射到 keyword（曾因参数名不匹配被静默忽略，
#              导致 LIKE 条件整段跳过、返回全部上架商品）；3.20b 用负向对照锁死该行为。
#       3.15   编辑重审：1-上架中 改关键字段 → 必须回到 3-待审核（3.15e），
#              只改非关键字段 → 必须保持 1（3.15h）。此前用例编辑的是本就处于 3 的商品，等于没测。
#  9. 【6.0.2 起支付回调必须签名】/order/pay/callback 现在校验 HMAC-SHA256 签名，
#     无签名 / 错签名 / 时间戳超出 5 分钟窗口一律返回 code=100「回调签名校验失败」。
#     签名算法：sign = HMAC-SHA256(orderNo + "|" + tradeNo + "|" + timestamp, PAY_CALLBACK_SECRET)
#              （十六进制小写；timestamp 为毫秒）
#     ⚠️ 跑 §4.28c / §4.28d 之前，后端必须以同一个密钥启动，例如：
#          $env:PAY_CALLBACK_SECRET = "dev-pay-callback-secret-0123456789-abcdefgh"
#        （密钥在 0.0 里写入 {{pay_callback_secret}}，两处必须一致；不注入密钥时回调一律被拒绝）
###############################################################################


###############################################################################
# §0  环境自检
###############################################################################

### 0.0 【必先执行】初始化变量 + 健康检查
# 说明：本请求负责写入 {{base}} 和 {{run}}（本次运行的唯一后缀，保证脚本可重复执行）。
#       run 用时间戳后 8 位，使 seller{{run}} / buyer{{run}} 等账号每次运行都不冲突。
# @name health
GET http://127.0.0.1:8080/actuator/health

> {%
    var suffix = String(Date.now()).slice(-8);

    client.global.set("base", "http://127.0.0.1:8080/api/v1");
    client.global.set("run", suffix);
    client.global.set("pwd", "Passw0rd!2024");          // 8-20 位 + 字母 + 数字 + 特殊字符
    client.global.set("pwd_new", "NewPassw0rd!2024");

    // 6.0.2 起：支付回调必须验签。这里写入的密钥必须与后端环境变量 PAY_CALLBACK_SECRET 一致，
    // 否则 §4.28c/4.28d 会返回 code=100「回调签名校验失败」。
    client.global.set("pay_callback_secret", "dev-pay-callback-secret-0123456789-abcdefgh");

    client.global.set("seller_user", "seller" + suffix);
    client.global.set("seller_email", "seller" + suffix + "@stu.edu.cn");
    client.global.set("buyer_user", "buyer" + suffix);
    client.global.set("buyer_email", "buyer" + suffix + "@stu.edu.cn");
    client.global.set("admin_user", "admin" + suffix);
    client.global.set("admin_email", "admin" + suffix + "@stu.edu.cn");
    client.global.set("pwtest_user", "pwtest" + suffix);
    client.global.set("pwtest_email", "pwtest" + suffix + "@stu.edu.cn");
    client.global.set("locktest_user", "locktest" + suffix);
    client.global.set("locktest_email", "locktest" + suffix + "@stu.edu.cn");

    client.test("0.0 健康检查：/actuator/health 完全公开且 UP", function () {
        client.assert(response.status === 200, "HTTP 应为 200，实际 " + response.status);
        client.assert(response.body.status === "UP", "status 应为 UP，实际 " + response.body.status);
    });
%}


### 0.1 knife4j 接口文档可访问（验证白名单没误伤文档路径）
# 预期：HTTP 200，返回 HTML。若 401 说明 PathConstants.PUBLIC_PATHS 有问题。
GET http://127.0.0.1:8080/doc.html

> {%
    client.test("0.1 knife4j 文档页公开可访问", function () {
        client.assert(response.status === 200, "HTTP 应为 200，实际 " + response.status);
    });
%}


### 0.2 未登录访问受保护接口（对应 §6「未登录访问」）
# 预期：HTTP 401 + code=401 + msg="请先登录"（NOT_LOGIN 而非 UNAUTHORIZED）
GET {{base}}/order/list

> {%
    client.test("0.2 未登录 → HTTP 401 / code 401 / msg=请先登录", function () {
        client.assert(response.status === 401, "HTTP 应为 401，实际 " + response.status);
        client.assert(response.body.code === 401, "code 应为 401，实际 " + response.body.code);
        client.assert(response.body.msg === "请先登录", "msg 应为「请先登录」，实际 " + response.body.msg);
    });
%}


### 0.3 可选认证路径：游客访问商品列表不报错
# 预期：HTTP 200 + code=200（无 Token 静默放行，不是 401）
GET {{base}}/product/list?page=1&size=10

> {%
    client.test("0.3 可选认证路径游客可访问", function () {
        client.assert(response.status === 200, "HTTP 应为 200，实际 " + response.status);
        client.assert(response.body.code === 200, "code 应为 200，实际 " + response.body.code);
    });
%}


### 0.4 分类列表（可选认证，应有 6 条 seed 分类）
GET {{base}}/category/list

> {%
    client.test("0.4 分类列表返回 seed 分类（初始 6 条）", function () {
        client.assert(response.status === 200, "HTTP 应为 200");
        // 用 >= 6 而非 == 6：§3.22 会新建临时分类，若中途中断未清理会多于 6 条
        client.assert(response.body.data.length >= 6, "分类数应 >= 6，实际 " + response.body.data.length);
    });
%}


###############################################################################
# §1  造数据
#     现状：tb_user / tb_product / tb_order 全为空，无任何管理员账号，必须先造。
#     硬约束：不能购买自己发布的商品（OrderCreateService:53）→ 必须卖家/买家两个账号。
#     硬约束：商品必须 status=1 才能下单 → 发布后是 status=3，必须先过审。
###############################################################################

### 1.1 卖家 · 获取邮箱验证码
# email.skip=true 时验证码直接在 data.code 返回，不依赖 SMTP（答辩现场无网也能跑）
GET {{base}}/auth/email-code?email={{seller_email}}&scene=REGISTER

> {%
    client.global.set("seller_code", response.body.data ? response.body.data.code : "");
    client.test("1.1 卖家验证码（降级模式直接返回）", function () {
        client.assert(response.body.code === 200, "code 应为 200，实际 " + response.body.code);
        client.assert(response.body.data.skip === true, "skip 应为 true（EMAIL_SKIP=true）");
        client.assert(!!response.body.data.code, "data.code 不应为空");
    });
%}


