###############################################################################
# §2  认证与安全（非破坏性）
###############################################################################

### 2.1 登录失败 → 101
# ⚠️ 每次执行都会累加 login:fail 计数，连续 5 次会锁账号 15 分钟。
#    清理：redis-cli DEL login:fail:{{buyer_user}}
POST {{base}}/auth/login
Content-Type: application/json

{
  "username": "{{buyer_user}}",
  "password": "WrongPassword!999"
}

> {%
    client.test("2.1 密码错误 → HTTP 200 / code=101", function () {
        client.assert(response.status === 200, "HTTP 应为 200（业务失败也是 200），实际 " + response.status);
        client.assert(response.body.code === 101, "code 应为 101，实际 " + response.body.code);
        client.assert(response.body.msg === "用户名或密码错误", "msg 不符，实际 " + response.body.msg);
    });
%}


### 2.2 管理员越权：普通用户访问管理端 → 403
GET {{base}}/admin/user/list?page=1&size=10
Authorization: Bearer {{seller_token}}

> {%
    client.test("2.2 普通用户访问管理端 → code=403", function () {
        client.assert(response.status === 200, "HTTP 应为 200，实际 " + response.status);
        client.assert(response.body.code === 403, "code 应为 403，实际 " + response.body.code);
        client.assert(response.body.msg === "无权限访问", "msg 不符，实际 " + response.body.msg);
    });
%}


### 2.3 非法/伪造 Token → HTTP 401
GET {{base}}/user/profile
Authorization: Bearer eyJhbGciOiJIUzI1NiJ9.fake.token

> {%
